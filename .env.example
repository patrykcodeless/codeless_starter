BASE_DOMAIN=example.com
COMPOSE_PROFILES=traefik,n8n,onyx,nocodb

TRAEFIK_IMAGE=traefik:v2.11
TRAEFIK_DOMAIN=traefik.example.com
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_BASIC_AUTH=traefik:\$apr1\$changeme\$2wH8KsEgbduEh1P1LzpT1/

N8N_IMAGE=n8nio/n8n
N8N_VERSION=1.72.0
N8N_DOMAIN=n8n.example.com

NOCODB_IMAGE=nocodb/nocodb
NOCODB_VERSION=0.204.3
NOCODB_DOMAIN=nocodb.example.com

ONYX_IMAGE=ghcr.io/onyx-oss/onyx
ONYX_VERSION=latest
ONYX_DOMAIN=onyx.example.com
